<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Map Container Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/map_container_bg"
        android:clipToPadding="false"
        android:padding="3dp">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top Left Back Button -->
        <ImageButton
            android:id="@+id/backToHomeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="Back to Home"
            android:elevation="6dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow" />

    </FrameLayout>

    <!-- Details Container (Hidden until a pin is tapped) -->
    <LinearLayout
        android:id="@+id/detailsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/details_card_bg"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/placeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#33195C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/placeDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#5B3E8C"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/pinPhoto"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:contentDescription="Photo attached to the selected pin"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <Button
            android:id="@+id/viewPostButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View post in feed"
            android:visibility="gone" />

        <Button
            android:id="@+id/addPinButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_button_bg"
            android:paddingVertical="12dp"
            android:text="Post Here with Pin"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/heatmapToggleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_button_secondary_bg"
            android:paddingVertical="12dp"
            android:text="Show Wildlife Heatmap"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_button_secondary_bg"
            android:paddingVertical="12dp"
            android:text="Recenter Map"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>